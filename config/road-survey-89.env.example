# Copy these settings into the server's existing .env, then restart the web process.
# Independent limits: four roads, four cameras per road, sixteen total GPU slots.
ROAD_SURVEY_WORKERS=4
ROAD_SURVEY_CAMERA_WORKERS=4
# Tuned for 1280 on server 89. 0 enables VRAM estimation; range: 0..64.
# A road task can override the batch size in its saved configuration.
ROAD_SURVEY_BATCH_SIZE=64

# Isolate each camera to avoid cross-camera Python GIL contention.
ROAD_SURVEY_EXECUTION=process
# Bounds effective batch without changing saved road configs/checkpoint identities.
ROAD_SURVEY_PROCESS_BATCH_CAP=32
