# Copy these settings into the server's existing .env, then restart the web process.
# Start with two lanes on an 80GB GPU and benchmark before increasing to 3 or 4.
ROAD_SURVEY_WORKERS=2
# 0: estimate from free VRAM, resolution and lane count. Range: 0..64.
# A road task can override the batch size in its saved configuration.
ROAD_SURVEY_BATCH_SIZE=0
